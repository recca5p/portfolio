{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/normalize-redirect.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seo:check": "node scripts/check-seo.mjs",
    "csp:check": "node scripts/check-csp.mjs",
    "html:check": "html-validate dist/index.html dist/404.html dist/en/index.html dist/vi/index.html dist/en/projects/index.html dist/vi/projects/index.html",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run seo:check && npm run csp:check && npm run html:check",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^8.70.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.16.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
