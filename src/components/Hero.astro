---
import { Image } from 'astro:assets';
import backendInfrastructure from '../assets/backend-infrastructure.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const imageAlt =
  lang === 'en'
    ? 'Fiber-optic network cables connected to backend infrastructure'
    : 'Cáp quang kết nối vào hạ tầng hệ thống backend';
---

<section class="hero-shell" aria-labelledby="hero-heading">
  <div class="site-container hero-grid">
    <div class="hero-copy hero-enter">
      <h1 id="hero-heading">{t('home.greeting')}</h1>
      <p class="hero-role">{t('home.title')}</p>
      <p class="hero-summary">{t('home.heroSummary')}</p>
      <div class="hero-actions">
        <a class="button-primary" href="#experience">{t('home.experienceCta')}</a>
        <a class="button-secondary" href="mailto:phatvo73.dev@gmail.com">
          {t('home.emailCta')}
        </a>
      </div>
    </div>

    <figure class="hero-visual">
      <Image
        src={backendInfrastructure}
        alt={imageAlt}
        width={960}
        height={1200}
        format="avif"
        quality={78}
        loading="eager"
        fetchpriority="high"
        sizes="(min-width: 1024px) 42vw, (min-width: 640px) 70vw, 100vw"
      />
      <figcaption>{t('home.imageCaption')}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero-shell {
    display: flex;
    min-height: calc(100dvh - 4.5rem);
    align-items: center;
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .hero-grid {
    display: grid;
    align-items: center;
    gap: 3rem;
  }

  .hero-copy {
    max-width: 42rem;
  }

  h1 {
    max-width: 9em;
    font-size: clamp(2.75rem, 7vw, 6rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 0.92;
  }

  .hero-role {
    margin-top: 1.15rem;
    color: var(--muted-strong);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .hero-summary {
    max-width: 34rem;
    margin-top: 0.85rem;
    color: var(--muted-strong);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-visual {
    position: relative;
    margin: 0;
  }

  .hero-visual :global(img) {
    width: 100%;
    max-height: min(68dvh, 47rem);
    border-radius: var(--radius);
    object-fit: cover;
    object-position: center;
    box-shadow: 0 2.5rem 7rem rgb(0 0 0 / 0.32);
  }

  figcaption {
    margin-top: 0.8rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.12fr) minmax(21rem, 0.88fr);
      gap: clamp(3rem, 7vw, 7rem);
    }
  }

  @media (max-width: 899px) {
    .hero-shell {
      align-items: flex-start;
    }

    .hero-visual {
      width: min(100%, 42rem);
    }

    .hero-visual :global(img) {
      max-height: 38rem;
    }
  }
</style>
