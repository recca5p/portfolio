---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero-shell" aria-labelledby="hero-heading">
  <div class="site-container hero-copy hero-enter">
    <h1 id="hero-heading">{t('home.greeting')}</h1>
    <p class="hero-role">{t('home.title')}</p>
    <p class="hero-tagline">{t('home.tagline')}</p>
    <p class="hero-facts">
      <span>{profile.location[lang]}</span>
      <span>{t('home.years')}</span>
      <span>{t('home.employer')}</span>
    </p>
    <p class="hero-summary">{t('home.heroSummary')}</p>
    <div class="hero-actions">
      <a class="button-primary" href={profile.cvPath} download>
        {t('home.downloadCv')}
      </a>
      <a
        class="button-secondary"
        href={profile.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
      <a
        class="button-secondary"
        href={profile.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      <a class="button-secondary" href={`mailto:${profile.email}`}>
        {t('home.emailCta')}
      </a>
      <a class="button-secondary" href="#experience">
        {t('home.experienceCta')}
      </a>
    </div>
  </div>
</section>

<style>
  .hero-shell {
    padding-block: clamp(2.5rem, 7vw, 5.5rem);
  }

  .hero-copy {
    max-width: 46rem;
  }

  h1 {
    max-width: 10em;
    font-size: var(--font-display);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 0.96;
  }

  .hero-role {
    max-width: 22em;
    margin-top: 1rem;
    color: var(--muted-strong);
    font-size: var(--font-lead);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .hero-tagline {
    max-width: 36rem;
    margin-top: 0.75rem;
    color: var(--text);
    font-size: var(--font-body);
    line-height: 1.5;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.85rem;
    color: var(--text);
    font-size: var(--font-small);
  }

  .hero-facts span:not(:last-child)::after {
    margin-left: 1rem;
    color: var(--line-strong);
    content: '/';
  }

  .hero-summary {
    max-width: 38rem;
    margin-top: 1.15rem;
    color: var(--muted-strong);
    font-size: var(--font-body);
    line-height: 1.65;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
</style>
