---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const metrics = t('home.metrics') as unknown as { value: string; label: string }[];
---

<section class="profile-summary" aria-labelledby="profile-summary-heading">
  <div class="site-container summary-grid">
    <div>
      <h2 id="profile-summary-heading" class="section-heading">
        {t('home.summaryTitle')}
      </h2>
      <p class="profile-bio" set:html={t('home.bio')} />
      <h3 class="ai-heading">{t('home.aiTitle')}</h3>
      <p class="ai-copy">{t('home.aiBody')}</p>
    </div>

    <ul class="result-notes">
      {metrics.map((metric) => (
        <li>
          <strong>{metric.value}</strong>
          <span>{metric.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .profile-summary {
    border-block: 1px solid var(--line);
    background: var(--surface);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .summary-grid {
    display: grid;
    gap: 2rem;
  }

  .profile-bio,
  .ai-copy {
    max-width: 68ch;
    color: var(--muted-strong);
    font-size: var(--font-body);
    line-height: 1.7;
  }

  .profile-bio {
    margin-top: 1.5rem;
  }

  .ai-heading {
    margin-top: 2rem;
    font-size: var(--font-title);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .ai-copy {
    margin-top: 0.85rem;
  }

  .result-notes {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .result-notes li {
    display: grid;
    gap: 0.2rem;
    border-top: 1px solid var(--line-strong);
    padding-top: 0.85rem;
    color: var(--muted-strong);
    font-size: var(--font-body);
    line-height: 1.45;
  }

  .result-notes strong {
    color: var(--text);
    font-size: var(--font-lead);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 900px) {
    .summary-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
      align-items: start;
      gap: clamp(3rem, 8vw, 6rem);
    }

    .result-notes {
      padding-top: 0.4rem;
    }
  }
</style>
