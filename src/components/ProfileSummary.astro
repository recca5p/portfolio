---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const results = t('home.results') as string[];
---

<section class="profile-summary" aria-labelledby="profile-summary-heading">
  <div class="site-container summary-grid">
    <div>
      <h2 id="profile-summary-heading" class="section-heading">
        {t('home.summaryTitle')}
      </h2>
      <p class="profile-bio" set:html={t('home.bio')} />
    </div>

    <ul class="result-notes">
      {results.map((result) => (
        <li>{result}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .profile-summary {
    border-block: 1px solid var(--line);
    background: var(--surface);
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .summary-grid {
    display: grid;
    gap: 2rem;
  }

  .profile-bio {
    max-width: 68ch;
    margin-top: 1.5rem;
    color: var(--muted-strong);
    font-size: var(--font-body);
    line-height: 1.7;
  }

  .result-notes {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .result-notes li {
    border-top: 1px solid var(--line-strong);
    padding-top: 0.85rem;
    color: var(--text);
    font-size: var(--font-body);
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    .summary-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(18rem, 0.6fr);
      align-items: start;
      gap: clamp(3rem, 8vw, 6rem);
    }

    .result-notes {
      padding-top: 0.4rem;
    }
  }
</style>
