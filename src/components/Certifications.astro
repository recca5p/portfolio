---
import { Image, getImage } from 'astro:assets';
import certificate from '../assets/pl-400-certificate.png';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const certificateImage = await getImage({
  src: certificate,
  width: 1100,
  format: 'webp',
});

const facts = [
  {
    label: t('certifications.earnedLabel'),
    value: t('certifications.earned'),
    verbatim: false,
    mono: true,
  },
  {
    label: t('certifications.renewalLabel'),
    value: t('certifications.renewal'),
    verbatim: false,
    mono: false,
  },
  {
    label: t('certifications.expiredLabel'),
    value: t('certifications.expired'),
    verbatim: false,
    mono: true,
  },
  {
    label: t('certifications.credentialLabel'),
    value: t('certifications.credentialId'),
    verbatim: true,
    mono: true,
  },
];
---

<section
  id="certifications"
  class="section-shell certifications-section"
  aria-labelledby="certifications-heading"
>
  <div class="site-container certifications-layout">
    <div class="certifications-intro">
      <h2 id="certifications-heading" class="section-heading">
        {t('certifications.title')}
      </h2>
    </div>

    <article>
      <h3 translate="no">{t('certifications.name')}</h3>
      <p class="cert-summary">{t('certifications.summary')}</p>
      <dl>
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd
              class:list={[fact.mono && 'mono']}
              {...(fact.verbatim ? { translate: 'no' as const } : {})}
            >
              {fact.value}
            </dd>
          </div>
        ))}
      </dl>
      <figure>
        <Image
          src={certificate}
          alt={String(t('certifications.imageAlt'))}
          widths={[480, 768, 1100]}
          sizes="(min-width: 900px) 36rem, calc(100vw - 2rem)"
          loading="lazy"
        />
        <figcaption>
          <a href={certificateImage.src} target="_blank" rel="noopener noreferrer">
            {t('certifications.view')}
          </a>
        </figcaption>
      </figure>
    </article>
  </div>
</section>

<style>
  .certifications-section {
    border-top: 1px solid var(--line);
  }

  .certifications-layout {
    display: grid;
    gap: 3rem;
  }

  article h3 {
    max-width: 36rem;
    font-size: var(--font-title);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .cert-summary {
    margin-top: 1rem;
    color: var(--muted-strong);
    font-size: var(--font-body);
  }

  dl {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }

  dl div {
    display: grid;
    gap: 0.35rem;
    border-bottom: 1px solid var(--line);
    padding-block: 1rem;
  }

  dt {
    color: var(--muted);
    font-size: var(--font-small);
  }

  dd {
    margin: 0;
    color: var(--text);
    font-size: var(--font-body);
    font-weight: 650;
    line-height: 1.5;
  }

  dd.mono {
    font-family: var(--font-mono);
    font-size: var(--font-meta);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  figure {
    max-width: 36rem;
    margin-top: 2rem;
  }

  figure :global(img) {
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.85rem;
  }

  figcaption a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--accent);
    font-size: var(--font-small);
    font-weight: 650;
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  figcaption a:hover {
    color: var(--accent-strong);
  }

  @media (min-width: 900px) {
    .certifications-layout {
      grid-template-columns: minmax(14rem, 0.58fr) minmax(0, 1.42fr);
      gap: clamp(4rem, 9vw, 9rem);
    }

    .certifications-intro {
      position: sticky;
      top: 4.75rem;
      align-self: start;
    }
  }
</style>
