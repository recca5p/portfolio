---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="education" class="section-shell education-section" aria-labelledby="education-heading">
  <div class="site-container">
    <h2 id="education-heading" class="section-heading">
      {t('education.title')}
    </h2>

    <div class="education-grid">
      <article class="degree-panel">
        <p class="degree-period">2018 - 2023</p>
        <h3 translate="no">Ton Duc Thang University</h3>
        <p class="degree-name">{t('education.degree')}</p>
        <p class="degree-location">{t('education.location')}</p>
      </article>

      <div class="credentials">
        <h3>{t('education.certTitle')}</h3>
        <dl>
          <div>
            <dt translate="no">Microsoft</dt>
            <dd>Power Platform Developer Associate</dd>
          </div>
          <div>
            <dt>{t('education.englishProficiency')}</dt>
            <dd translate="no">IELTS 6.5 (IDP)</dd>
          </div>
          <div>
            <dt>{t('education.englishProficiency')}</dt>
            <dd translate="no">TOEIC 700+</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .education-section {
    border-top: 1px solid var(--line);
  }

  .education-grid {
    display: grid;
    gap: 3rem;
    margin-top: 3rem;
  }

  .degree-panel {
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }

  .degree-period {
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .degree-panel h3 {
    max-width: 15ch;
    margin-top: 1.5rem;
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .degree-name {
    margin-top: 1rem;
    color: var(--muted-strong);
    font-size: 0.95rem;
  }

  .degree-location {
    margin-top: 0.45rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .credentials h3 {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .credentials dl {
    margin-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
  }

  .credentials dl div {
    display: grid;
    gap: 0.45rem;
    border-bottom: 1px solid var(--line);
    padding-block: 1.25rem;
  }

  .credentials dt {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .credentials dd {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 650;
  }

  @media (min-width: 768px) {
    .education-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
      align-items: start;
      gap: clamp(3rem, 8vw, 8rem);
    }
  }
</style>
