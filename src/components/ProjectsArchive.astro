---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Project } from '../types/project';
import projectsData from '../data/projects.json';
import { formatProse, teamSizeLabel } from '../utils/text';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projects = projectsData as Project[];

/*
 * Open questions live as comments in Experience.astro. Do not add metrics
 * beyond 20x, more than 60%, 5x, ~30%, and 90%+.
 * Homepage preview is pinned by id in Projects.astro.
 */
---

<section class="section-shell archive-section" aria-labelledby="projects-heading">
  <div class="site-container">
    <nav aria-label={lang === 'en' ? 'Breadcrumb' : 'Đường dẫn điều hướng'} class="breadcrumb">
      <ol>
        <li>
          <a href={`/${lang}/`}>{t('nav.home')}</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{t('projects.title')}</li>
      </ol>
    </nav>

    <header class="archive-header">
      <h1 id="projects-heading">{t('projects.title')}</h1>
      <p>{t('projects.viewAllSubtitle')}</p>
      <span>
        {projects.length} {lang === 'en' ? 'projects' : 'dự án'}
      </span>
    </header>

    <div class="archive-list">
      {projects.map((project) => {
        const title = project.title[lang];
        const description = formatProse(project.description[lang]);
        const role = project.role ? formatProse(project.role[lang]) : undefined;
        const engagement = project.engagement ? formatProse(project.engagement[lang]) : undefined;
        const teamLabel = teamSizeLabel(project.teamSize, lang, String(t('projects.solo')));
        const companyName = project.company?.name[lang] ?? '';
        const companyLabel =
          lang === 'en' ? `Visit ${companyName} website` : `Truy cập trang web ${companyName}`;

        return (
          <article>
            <div class="archive-title">
              <h2>{title}</h2>
              {role && <p class="project-byline">{role}</p>}
              {engagement && <p class="project-byline">{engagement}</p>}
              {teamLabel && <p class="team-size">{teamLabel}</p>}
            </div>

            <div class="archive-copy">
              <p class="archive-description">{description}</p>
              {project.sources && project.sources.length > 0 && (
                <p class="source-line">
                  <span>{t('experience.source')}: </span>
                  {project.sources.map((source) => (
                    <a href={source.url} target="_blank" rel="noopener noreferrer">
                      {source.label[lang]}
                    </a>
                  ))}
                </p>
              )}
            </div>

            <div class="archive-meta">
              <p class="tag-line" translate="no">
                {project.tags.join(' / ')}
              </p>
              {project.company?.url && (
                <a
                  href={project.company.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={companyLabel}
                >
                  <span translate="no">{companyName}</span>
                </a>
              )}
              {project.company?.description?.[lang] && (
                <p class="company-context">{formatProse(project.company.description[lang])}</p>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .archive-section {
    padding-top: clamp(3rem, 7vw, 5.5rem);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    color: var(--muted);
    font-size: var(--font-small);
    list-style: none;
  }

  .breadcrumb a {
    min-width: 2.75rem;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--muted-strong);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .breadcrumb a:hover {
    color: var(--text);
    text-decoration-color: var(--accent);
  }

  .archive-header {
    margin-top: 2rem;
  }

  .archive-header h1 {
    max-width: 16ch;
    font-size: var(--font-display);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .archive-header p {
    max-width: 58ch;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: var(--font-body);
    line-height: 1.75;
  }

  .archive-header > span {
    display: block;
    margin-top: 1.25rem;
    color: var(--accent-strong);
    font-size: var(--font-small);
    font-variant-numeric: tabular-nums;
    font-weight: 650;
  }

  .archive-list {
    margin-top: clamp(3.5rem, 8vw, 7rem);
    border-top: 1px solid var(--line-strong);
  }

  article {
    display: grid;
    gap: 1.5rem;
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .project-byline,
  .team-size {
    margin-top: 0.75rem;
    color: var(--muted-strong);
    font-size: var(--font-body);
    line-height: 1.5;
  }

  .team-size {
    margin-top: 0.9rem;
    color: var(--muted);
  }

  .team-size span {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  h2 {
    font-size: var(--font-title);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.25;
  }

  .archive-description {
    color: var(--muted-strong);
    font-size: var(--font-body);
    line-height: 1.7;
  }

  .source-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: var(--font-small);
  }

  .source-line a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--muted-strong);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .archive-meta p.company-context {
    margin-top: 1rem;
    color: var(--muted-strong);
    font-family: var(--font-sans);
    font-size: var(--font-body);
    line-height: 1.6;
  }

  .archive-meta {
    align-self: start;
  }

  .archive-meta p.tag-line {
    overflow-wrap: anywhere;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--font-meta);
    line-height: 1.7;
  }

  .archive-meta a {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    color: var(--muted-strong);
    font-size: var(--font-small);
    font-weight: 700;
    text-decoration-color: transparent;
    text-decoration-line: underline;
    text-underline-offset: 0.3em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .archive-meta a:hover {
    color: var(--text);
    text-decoration-color: var(--accent);
  }

  @media (min-width: 900px) {
    article {
      grid-template-columns: minmax(14rem, 0.72fr) minmax(0, 1.15fr) minmax(12rem, 0.55fr);
      gap: clamp(2rem, 5vw, 5rem);
    }
  }
</style>
