---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const categoryKeys = ['backend', 'database', 'cloud', 'ai', 'testing', 'frontend'] as const;

const skillTags: Record<(typeof categoryKeys)[number], string[]> = {
  backend: ['Go', 'C# / .NET', 'Java', 'Python', 'gRPC', 'Microservices'],
  database: ['PostgreSQL', 'SQL Server', 'Oracle', 'Kafka', 'RabbitMQ', 'Redis'],
  cloud: ['GCP', 'AWS', 'Azure', 'Kubernetes', 'Docker', 'Helm'],
  ai: ['Claude Code', 'Azure OpenAI', 'Azure AI Speech', 'Anthropic Claude'],
  testing: ['Go testing', 'MSTest', 'Selenium', 'SonarQube', 'Fortify'],
  frontend: ['Angular', 'TypeScript'],
};
---

<section id="skills" class="section-shell skills-section" aria-labelledby="skills-heading">
  <div class="site-container skills-layout">
    <div class="skills-intro">
      <h2 id="skills-heading" class="section-heading">
        {t('skills.title')}
      </h2>
    </div>

    <div class="skill-accordions">
      {categoryKeys.map((key) => {
        const title = String(t(`skills.categories.${key}.title`));
        const description = String(t(`skills.categories.${key}.description`));
        const details = Array.from(t(`skills.categories.${key}.details`) as string[]);

        return (
          <div class="skill-group">
            <details>
              <summary>
                <span class="skill-summary-copy">
                  <span class="skill-title">{title}</span>
                  <span class="skill-description">{description}</span>
                </span>
                <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
                  <path
                    d="M3.5 6.5 8 11l4.5-4.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </summary>
              <ul>
                {details.map((detail) => (
                  <li>{detail}</li>
                ))}
              </ul>
            </details>
            <p class="stack-line" translate="no">
              {skillTags[key].join(' / ')}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .skills-section {
    background: var(--page);
  }

  .skills-layout {
    display: grid;
    gap: 3rem;
  }

  .skill-accordions {
    border-top: 1px solid var(--line-strong);
  }

  .skill-group {
    border-bottom: 1px solid var(--line);
    padding-bottom: 1.25rem;
  }

  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.75rem;
    gap: 1.5rem;
    align-items: center;
    padding-block: 1.25rem 0.75rem;
    cursor: pointer;
  }

  .skill-summary-copy {
    display: grid;
    gap: 0.45rem;
  }

  .skill-title {
    color: var(--text);
    font-size: var(--font-lead);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .skill-description {
    max-width: 62ch;
    color: var(--muted-strong);
    font-size: var(--font-body);
    line-height: 1.6;
  }

  .chevron {
    justify-self: end;
    color: var(--accent-strong);
    transition: transform 180ms var(--ease-out);
  }

  details[open] .chevron {
    transform: rotate(180deg);
  }

  .skill-group ul {
    display: grid;
    list-style: disc;
    gap: 0.75rem;
    max-width: 60rem;
    margin: 0.25rem 0 0;
    padding-left: 1.15rem;
    color: var(--muted-strong);
    font-size: var(--font-body);
    line-height: 1.6;
  }

  .skill-group li::marker {
    color: var(--accent);
  }

  .stack-line {
    margin-top: 0.85rem;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: var(--font-meta);
    line-height: 1.7;
  }

  @media (min-width: 900px) {
    .skills-layout {
      grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1.28fr);
      gap: clamp(4rem, 9vw, 9rem);
    }

    .skills-intro {
      position: sticky;
      top: 4.75rem;
      align-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }
</style>
