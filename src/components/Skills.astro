---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const categoryKeys = ['backend', 'database', 'cloud', 'ai', 'testing', 'frontend'] as const;

const skillTags: Record<(typeof categoryKeys)[number], string[]> = {
  backend: ['.NET Core', 'Golang', 'Java', 'Python', 'gRPC', 'Microservices'],
  database: ['PostgreSQL', 'SQL Server', 'Oracle', 'Kafka', 'RabbitMQ', 'Redis'],
  cloud: ['GCP', 'AWS', 'Azure', 'Kubernetes', 'Terraform', 'Docker'],
  ai: ['Gemini API', 'AWS Bedrock', 'Claude API', 'LLMs', 'Prompt Engineering'],
  testing: ['xUnit', 'NUnit', 'JUnit', 'Selenium', 'Fortify', 'JMeter'],
  frontend: ['Angular', 'React', 'React Native', 'TypeScript', 'Vite'],
};
---

<section id="skills" class="section-shell skills-section" aria-labelledby="skills-heading">
  <div class="site-container skills-layout">
    <div class="skills-intro" data-reveal>
      <h2 id="skills-heading" class="section-heading">{t('skills.title')}</h2>
      <p class="section-copy">{t('skills.subtitle')}</p>
    </div>

    <div class="skill-accordions" data-reveal>
      {
        categoryKeys.map((key, index) => {
          const title = String(t(`skills.categories.${key}.title`));
          const description = String(t(`skills.categories.${key}.description`));
          const details = Array.from(t(`skills.categories.${key}.details`) as string[]);

          return (
            <details open={index === 0}>
              <summary>
                <span class="skill-summary-copy">
                  <span class="skill-title">{title}</span>
                  <span class="skill-description">{description}</span>
                </span>
                <span class="detail-mark" aria-hidden="true" />
              </summary>

              <div class="skill-detail">
                <ul>
                  {details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
                <p class="stack-line" translate="no">
                  {skillTags[key].join(' / ')}
                </p>
              </div>
            </details>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .skills-section {
    background: var(--page);
  }

  .skills-layout {
    display: grid;
    gap: 3rem;
  }

  .skills-intro .section-copy {
    margin-top: 1.35rem;
  }

  .skill-accordions {
    border-top: 1px solid var(--line-strong);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2.75rem;
    gap: 1.5rem;
    align-items: start;
    padding-block: 1.5rem;
    cursor: pointer;
  }

  .skill-summary-copy {
    display: grid;
    gap: 0.55rem;
  }

  .skill-title {
    color: var(--text);
    font-size: 1.08rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .skill-description {
    max-width: 58ch;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .detail-mark {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--accent-strong);
    font-family: var(--font-mono);
    transition:
      border-color 160ms ease,
      background-color 160ms ease;
  }

  .detail-mark::before {
    content: '+';
  }

  details[open] .detail-mark {
    border-color: var(--line-strong);
    background: var(--surface);
  }

  details[open] .detail-mark::before {
    content: '−';
  }

  .skill-detail {
    max-width: 60rem;
    padding: 0 4.25rem 1.75rem 0;
  }

  .skill-detail ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding-left: 1.15rem;
    color: var(--muted-strong);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .skill-detail li::marker {
    color: var(--accent);
  }

  .stack-line {
    margin-top: 1.25rem;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.8;
  }

  @media (min-width: 900px) {
    .skills-layout {
      grid-template-columns: minmax(16rem, 0.72fr) minmax(0, 1.28fr);
      gap: clamp(4rem, 9vw, 9rem);
    }

    .skills-intro {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
</style>
