---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import type { Project } from '../types/project';
import { formatProse } from '../utils/text';

interface Props {
  project: Project;
  lang: Lang;
  featured?: boolean;
}

const { project, lang, featured = false } = Astro.props;
const t = useTranslations(lang);
const title = formatProse(project.title[lang]);
const description = formatProse(project.description[lang]);
const role = project.role ? formatProse(project.role[lang]) : undefined;
const teamLabel =
  project.teamSize === 1 ? String(t('projects.solo')) : `${t('projects.team')} ${project.teamSize}`;
const companyLabel =
  lang === 'en'
    ? `Visit ${project.company?.name ?? ''} website`
    : `Truy cập trang web ${project.company?.name ?? ''}`;
---

<article class:list={['project-card lift-on-hover', { featured }]}>
  <h3>{title}</h3>
  {role && <p class="project-byline">{role}</p>}
  <p class="project-description">{description}</p>

  <div class="project-footer">
    <p class="project-stack" translate="no">
      {project.tags.slice(0, featured ? 8 : 5).join(' / ')}
    </p>
    <p class="project-team">{teamLabel}</p>
    {project.company?.url && (
      <a
        href={project.company.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={companyLabel}
      >
        <span translate="no">{project.company.name}</span>
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  .project-card.featured {
    border-color: var(--line-strong);
    background: var(--surface-raised);
  }

  h3 {
    font-size: var(--font-title);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .featured h3 {
    max-width: 18ch;
  }

  .project-byline,
  .project-description,
  .project-team {
    color: var(--muted-strong);
    font-size: var(--font-body);
    line-height: 1.65;
  }

  .project-byline {
    margin-top: 0.75rem;
  }

  .project-description {
    margin-top: 0.85rem;
  }

  .featured .project-description {
    max-width: 62ch;
  }

  .project-footer {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .project-stack {
    overflow-wrap: anywhere;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--font-meta);
    line-height: 1.7;
  }

  .project-footer a {
    display: inline-flex;
    width: fit-content;
    min-height: 2.75rem;
    align-items: center;
    color: var(--muted-strong);
    font-size: var(--font-small);
    font-weight: 700;
    text-decoration-color: transparent;
    text-decoration-line: underline;
    text-underline-offset: 0.3em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .project-footer a:hover {
    color: var(--text);
    text-decoration-color: var(--accent);
  }
</style>
