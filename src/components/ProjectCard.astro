---
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import type { Project } from '../types/project';
import { formatProse, teamSizeLabel } from '../utils/text';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const title = project.title[lang];
const description = formatProse(project.description[lang]);
const role = project.role ? formatProse(project.role[lang]) : undefined;
const engagement = project.engagement ? formatProse(project.engagement[lang]) : undefined;
const teamLabel = teamSizeLabel(project.teamSize, lang, String(t('projects.solo')));
const companyName = project.company?.name[lang] ?? '';
const companyLabel =
  lang === 'en' ? `Visit ${companyName} website` : `Truy cập trang web ${companyName}`;
---

<article class="project-card lift-on-hover">
  <h3>{title}</h3>
  {role && <p class="project-byline">{role}</p>}
  {engagement && <p class="project-byline">{engagement}</p>}
  <p class="project-description">{description}</p>
  {project.sources && project.sources.length > 0 && (
    <p class="project-sources">
      <span>{t('experience.source')}: </span>
      {project.sources.map((source) => (
        <a href={source.url} target="_blank" rel="noopener noreferrer">
          {source.label[lang]}
        </a>
      ))}
    </p>
  )}

  <div class="project-footer">
    <p class="project-stack" translate="no">
      {project.tags.slice(0, 5).join(' / ')}
    </p>
    {teamLabel && <p class="project-team">{teamLabel}</p>}
    {project.company?.url && (
      <a
        href={project.company.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={companyLabel}
      >
        <span translate="no">{companyName}</span>
      </a>
    )}
  </div>
</article>

<style>
  .project-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    padding: clamp(1.4rem, 3vw, 2rem);
  }

  h3 {
    font-size: var(--font-title);
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .project-byline,
  .project-description,
  .project-sources,
  .project-team {
    color: var(--muted-strong);
    font-size: var(--font-body);
    line-height: 1.65;
  }

  .project-byline {
    margin-top: 0.75rem;
  }

  .project-description {
    margin-top: 0.85rem;
  }

  .project-sources {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    margin-top: 0.85rem;
    font-size: var(--font-small);
  }

  .project-sources a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--accent);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .project-footer {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .project-stack {
    overflow-wrap: anywhere;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--font-meta);
    line-height: 1.7;
  }

  .project-footer a {
    display: inline-flex;
    width: fit-content;
    min-height: 2.75rem;
    align-items: center;
    color: var(--muted-strong);
    font-size: var(--font-small);
    font-weight: 700;
    text-decoration-color: transparent;
    text-decoration-line: underline;
    text-underline-offset: 0.3em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .project-footer a:hover {
    color: var(--text);
    text-decoration-color: var(--accent);
  }
</style>
