---
import { Image } from 'astro:assets';
import logo from '../assets/logo-192.png';
import LangToggle from './LangToggle.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homePath = `/${lang}/`;
const projectsPath = `/${lang}/projects/`;
const onHome = Astro.url.pathname === homePath;
const onProjects = Astro.url.pathname === projectsPath;
const displayName = String(t('home.greeting'));

const navItems = [
  ...(onHome ? [] : [{ path: homePath, label: t('nav.home'), current: false }]),
  { path: `${homePath}#experience`, label: t('nav.experience'), current: false },
  { path: projectsPath, label: t('nav.projects'), current: onProjects },
  { path: `${homePath}#contact`, label: t('nav.contact'), current: false },
];
---

<header class="site-header">
  <div class="site-container header-row">
    <a
      class="brand-link pressable"
      href={homePath}
      aria-label={`${t('nav.home')} - ${displayName}`}
    >
      <Image
        src={logo}
        alt=""
        width={36}
        height={36}
        densities={[1, 2]}
        format="png"
        loading="eager"
        aria-hidden="true"
      />
      <span class="brand-name">{displayName}</span>
    </a>

    <div class="header-tools">
      <nav
        class="primary-nav"
        aria-label={lang === 'en' ? 'Primary navigation' : 'Điều hướng chính'}
      >
        <ul>
          {navItems.map((item) => (
            <li>
              <a href={item.path} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <LangToggle />
      <details class="mobile-menu">
        <summary class="pressable">
          <span class="when-closed">{t('nav.menu')}</span>
          <span class="when-open">{t('nav.close')}</span>
        </summary>
        <nav aria-label={lang === 'en' ? 'Mobile navigation' : 'Điều hướng di động'}>
          <ul>
            {navItems.map((item) => (
              <li>
                <a href={item.path} aria-current={item.current ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var menu = document.querySelector('.mobile-menu');
    if (!menu) return;
    var summary = menu.querySelector('summary');

    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      if (summary) summary.focus();
    });

    document.addEventListener('click', function (event) {
      if (!menu.open) return;
      if (event.target instanceof Node && menu.contains(event.target)) return;
      menu.open = false;
    });

    menu.querySelectorAll('a').forEach(function (link) {
      link.addEventListener('click', function () {
        menu.open = false;
      });
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 78%, transparent);
    background: color-mix(in srgb, var(--page) 95%, transparent);
    padding-top: env(safe-area-inset-top);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .header-row,
  .header-tools {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .header-tools {
    min-height: 0;
    justify-content: flex-end;
  }

  .brand-link {
    display: inline-flex;
    min-width: 2.75rem;
    min-height: 2.75rem;
    flex: 0 1 auto;
    align-items: center;
    gap: 0.7rem;
    border-radius: var(--radius);
    color: var(--text);
    font-size: var(--font-small);
    font-weight: 750;
    letter-spacing: -0.02em;
    white-space: nowrap;
    transition:
      color 160ms ease,
      transform 160ms var(--ease-out);
  }

  .brand-name {
    white-space: nowrap;
  }

  .brand-link img {
    border-radius: calc(var(--radius) * 0.55);
  }

  .brand-link:hover {
    color: var(--accent-strong);
  }

  .primary-nav {
    display: none;
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu .when-open {
    display: none;
  }

  .mobile-menu[open] .when-closed {
    display: none;
  }

  .mobile-menu[open] .when-open {
    display: inline;
  }

  .mobile-menu summary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.6rem 0.8rem;
    color: var(--muted-strong);
    cursor: pointer;
    font-size: var(--font-small);
    font-weight: 700;
    white-space: nowrap;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease,
      transform 160ms var(--ease-out);
  }

  .mobile-menu summary:hover,
  .mobile-menu[open] summary {
    border-color: var(--line-strong);
    background: var(--surface);
    color: var(--text);
  }

  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: min(16rem, calc(100vw - 2rem));
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-raised);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.32);
  }

  .mobile-menu ul,
  .primary-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-menu ul {
    display: grid;
    padding: 0.45rem;
  }

  .mobile-menu a {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    border-radius: calc(var(--radius) - 0.25rem);
    padding-inline: 0.8rem;
    color: var(--muted-strong);
    font-size: var(--font-small);
    font-weight: 650;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .mobile-menu a:hover,
  .mobile-menu a[aria-current='page'] {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--text);
  }

  @media (max-width: 360px) {
    .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (min-width: 768px) {
    .primary-nav {
      display: block;
    }

    .primary-nav ul {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .primary-nav a {
      display: inline-flex;
      min-width: 2.75rem;
      min-height: 2.75rem;
      align-items: center;
      justify-content: center;
      padding-inline: 0.35rem;
      color: var(--muted);
      font-size: var(--font-small);
      font-weight: 650;
      white-space: nowrap;
      transition: color 160ms ease;
    }

    .primary-nav a:hover,
    .primary-nav a[aria-current='page'] {
      color: var(--text);
    }

    .primary-nav a[aria-current='page'] {
      text-decoration-line: underline;
      text-decoration-color: var(--accent);
      text-underline-offset: 0.35em;
    }

    .mobile-menu {
      display: none;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--page);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }
</style>
