---
import ProjectCard from './ProjectCard.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import type { Project } from '../types/project';
import projectsData from '../data/projects.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const homepageIds = ['bollore-otel', 'halliburton-ecompletion', 'ioga'];
const projects = homepageIds.map((id) => {
  const project = (projectsData as Project[]).find((item) => item.id === id);
  if (!project) {
    throw new Error(`Missing homepage project: ${id}`);
  }
  return project;
});
---

<section id="projects" class="section-shell projects-section" aria-labelledby="projects-heading">
  <div class="site-container">
    <div class="projects-intro">
      <h2 id="projects-heading" class="section-heading">
        {t('projects.title')}
      </h2>
      <p class="section-copy">{t('projects.subtitle')}</p>
    </div>

    <div class="projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>

    <div class="projects-action">
      <a class="button-secondary" href={`/${lang}/projects/`}>
        {t('projects.viewAll')}
      </a>
    </div>
  </div>
</section>

<style>
  .projects-section {
    border-top: 1px solid var(--line);
    background: var(--page);
  }

  .projects-intro .section-copy {
    margin-top: 1.35rem;
  }

  .projects-grid {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
  }

  .projects-action {
    display: flex;
    margin-top: 1.5rem;
    justify-content: flex-end;
  }

  @media (min-width: 900px) {
    .projects-grid {
      align-items: stretch;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
