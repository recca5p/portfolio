---
import { getLangFromUrl, ui } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const switchLangPath = (targetLang: string) => {
  const segments = Astro.url.pathname.split('/').filter(Boolean);

  if (segments[0] in ui) segments[0] = targetLang;
  else segments.unshift(targetLang);

  return `/${segments.join('/')}/`;
};

const languageLabel = lang === 'en' ? 'Choose language' : 'Chọn ngôn ngữ';
---

<nav class="language-switch" aria-label={languageLabel}>
  <a
    href={switchLangPath('en')}
    lang="en"
    hreflang="en"
    aria-current={lang === 'en' ? 'page' : undefined}
  >
    EN
  </a>
  <span aria-hidden="true">/</span>
  <a
    href={switchLangPath('vi')}
    lang="vi"
    hreflang="vi"
    aria-current={lang === 'vi' ? 'page' : undefined}
  >
    VI
  </a>
</nav>

<style>
  .language-switch {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    color: var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.08em;
  }

  .language-switch a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--muted);
    transition: color 160ms ease;
  }

  .language-switch a:hover,
  .language-switch a[aria-current='page'] {
    color: var(--text);
  }

  .language-switch a[aria-current='page'] {
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }
</style>
