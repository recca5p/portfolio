---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import experiencesData from '../data/experience.json';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cleanPunctuation = (text: string): string => text.replace(/\s*[\u2013\u2014]\s*/g, ' - ');
const renderMarkdownBold = (text: string): string =>
  cleanPunctuation(text).replace(
    /\*\*(.*?)\*\*/g,
    '<strong class="font-semibold text-white">$1</strong>'
  );

interface ExperienceEntry {
  company: string;
  role: Record<string, string>;
  period: Record<string, string>;
  bullets: Record<string, string[]>;
}

const experiences = (experiencesData as ExperienceEntry[]).map((experience) => ({
  company: cleanPunctuation(experience.company),
  role: cleanPunctuation(experience.role[lang] ?? ''),
  period: cleanPunctuation(experience.period[lang] ?? ''),
  bullets: experience.bullets[lang] ?? [],
}));
---

<section
  id="experience"
  class="section-shell experience-section"
  aria-labelledby="experience-heading"
>
  <div class="site-container experience-layout">
    <div class="experience-intro">
      <h2 id="experience-heading" class="section-heading">
        {t('experience.title')}
      </h2>
    </div>

    <ol class="experience-list">
      {experiences.map((experience) => (
        <li>
          <div class="role-meta">
            <p class="period">{experience.period}</p>
            <p class="company" translate="no">
              {experience.company}
            </p>
          </div>
          <article>
            <h3>{experience.role}</h3>
            <ul>
              {experience.bullets.map((bullet) => (
                <li>
                  <span set:html={renderMarkdownBold(bullet)} />
                </li>
              ))}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .experience-section {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .experience-layout {
    display: grid;
    gap: 3rem;
  }

  .experience-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience-list > li {
    display: grid;
    gap: 1.5rem;
    border-top: 1px solid var(--line-strong);
    padding-block: 2.25rem;
  }

  .role-meta {
    align-self: start;
  }

  .period {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }

  .company {
    margin-top: 0.55rem;
    color: var(--accent-strong);
    font-size: 0.88rem;
    font-weight: 650;
  }

  article h3 {
    color: var(--text);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  article ul {
    display: grid;
    gap: 0.9rem;
    margin: 1.35rem 0 0;
    padding-left: 1.2rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.75;
  }

  article li::marker {
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .experience-layout {
      grid-template-columns: minmax(14rem, 0.58fr) minmax(0, 1.42fr);
      gap: clamp(4rem, 9vw, 9rem);
    }

    .experience-intro {
      position: sticky;
      top: 7rem;
      align-self: start;
    }

    .experience-list > li {
      grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
