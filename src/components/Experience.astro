---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import experiencesData from '../data/experience.json';
import { formatProse, formatRange } from '../utils/text';

/*
 * Owner follow-ups. Do not render this list.
 * 1. Bifrost stack is Go and GCP. Do not add gRPC or data volumes. The confirmed outcome is about 2 million ANZ classic users, with under 1% errors.
 * 2. Feature lead time is one sprint to about 3 days, about 2x. Do not restore the old ~30% time-to-market line.
 * 3. He led the Sacombank CRM mobile migration from Xamarin to React Native. Keep both in the stack.
 * 4. Do not claim Go or gRPC at Halliburton. The owner confirmed they were not used there.
 * 5. Which Sacombank system used Golang is unknown. It stays on the stack line only.
 * 6. Freelance work ran alongside full-time jobs. Do not add dates. The label is "Freelance, alongside full-time roles".
 * 7. Gemini and Amazon Bedrock are confirmed in skills only. Do not tie them to a role or a metric. RAG stays unconfirmed. CV v7 lists Azure OpenAI, Azure AI Speech, Gemini and Amazon Bedrock. The old domain-consulting line is not in CV v7.
 * 8. Terraform and JMeter are confirmed in skills. NUnit, JUnit and event sourcing stay removed. xUnit and CQRS are in CV v7 and on Tally CRM only. Do not claim them at ANZ or Halliburton. Kafka and Redis stay. Do not claim .NET at ANZ. Do not claim Go or gRPC at Halliburton.
 * 9. "Zero-downtime releases" and "Led the adoption" stay removed. The confirmed CRM line is that he led the Xamarin to React Native migration.
 * 10. The ANZ role title is Software Engineer, via HCLTech Vietnam. JSON-LD jobTitle stays Software Engineer. The visible headline follows CV v7: Senior Backend Engineer, then .NET & Go, DevOps & Cloud, and Applied AI.
 * 11. Copilot-to-Claude history is only the ANZ experience bullet. Hero, meta, JSON-LD, and skills say Claude Code. Cursor stays on the Applied AI chips and is not an ANZ tool. Do not claim that ANZ applies these tools across engineering.
 * 12. Circular 78 stays removed. E-invoice copy says Ministry of Finance e-invoice rules.
 * 13. Tally Group is additional experience (group: additional), not a fourth main role. Main roles stay ANZ, Halliburton and Sacombank. Fee mechanics and CRM internals live on the two project entries.
 */

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const renderRich = (text: string): string =>
  formatProse(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*(.*?)\*\*/g, '<strong class="bullet-emphasis">$1</strong>')
    .replace(
      /\[([^\]]+)\]\((https:\/\/[^)\s]+)\)/g,
      '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
    );

interface SourceLink {
  label: Record<string, string>;
  url: string;
}

interface ExperienceEntry {
  company: Record<string, string>;
  role: Record<string, string>;
  period: Record<string, string>;
  domain?: Record<string, string>;
  group?: 'primary' | 'additional';
  context?: Record<string, string>;
  sources?: SourceLink[];
  publicContext?: Record<string, string[]>;
  bullets: Record<string, string[]>;
}

const experiences = (experiencesData as ExperienceEntry[]).map((experience) => ({
  company: experience.company[lang] ?? '',
  role: experience.role[lang] ?? '',
  period: formatRange(experience.period[lang] ?? ''),
  domain: experience.domain?.[lang] ?? '',
  group: experience.group ?? 'primary',
  context: experience.context?.[lang] ? formatProse(experience.context[lang]) : '',
  sources: (experience.sources ?? []).map((source) => ({
    label: source.label[lang] ?? source.label.en,
    url: source.url,
  })),
  publicContext: experience.publicContext?.[lang] ?? [],
  bullets: (experience.bullets[lang] ?? []).map((bullet) => formatProse(bullet)),
}));

type ExperienceRow =
  { kind: 'heading' } | { kind: 'job'; experience: (typeof experiences)[number] };

const rows: ExperienceRow[] = [];
let additionalHeadingPlaced = false;
for (const experience of experiences) {
  if (experience.group === 'additional' && !additionalHeadingPlaced) {
    rows.push({ kind: 'heading' });
    additionalHeadingPlaced = true;
  }
  rows.push({ kind: 'job', experience });
}
---

<section
  id="experience"
  class="section-shell experience-section"
  aria-labelledby="experience-heading"
>
  <div class="site-container experience-layout">
    <div class="experience-intro">
      <h2 id="experience-heading" class="section-heading">
        {t('experience.title')}
      </h2>
    </div>

    <ol class="experience-list">
      {rows.map((row) =>
        row.kind === 'heading' ? (
          <li class="additional-break">
            <div class="additional-copy">
              <h3 id="additional-experience-heading" class="additional-heading">
                {t('experience.additionalTitle')}
              </h3>
              <p class="additional-note">{t('experience.additionalNote')}</p>
            </div>
          </li>
        ) : (
          <li>
            <div class="role-meta">
              <p class="period">{row.experience.period}</p>
              {row.experience.domain && <p class="domain">{row.experience.domain}</p>}
            </div>
            <article>
              {row.experience.group === 'additional' ? (
                <h4>
                  <span class="role-title">{row.experience.role}</span>
                  <span class="employer" translate="no">
                    {row.experience.company}
                  </span>
                </h4>
              ) : (
                <h3>
                  <span class="role-title">{row.experience.role}</span>
                  <span class="employer" translate="no">
                    {row.experience.company}
                  </span>
                </h3>
              )}
              {row.experience.context && <p class="role-context">{row.experience.context}</p>}
              {row.experience.sources.length > 0 && (
                <p class="source-line">
                  <span>{t('experience.source')}: </span>
                  {row.experience.sources.map((source) => (
                    <a href={source.url} target="_blank" rel="noopener noreferrer">
                      {source.label}
                    </a>
                  ))}
                </p>
              )}
              <ul>
                {row.experience.bullets.map((bullet) => (
                  <li>
                    <span set:html={renderRich(bullet)} />
                  </li>
                ))}
              </ul>
              {row.experience.publicContext.length > 0 && (
                <details class="public-context">
                  <summary>
                    <span>{t('experience.publicContext')}</span>
                    <svg
                      class="chevron"
                      viewBox="0 0 16 16"
                      aria-hidden="true"
                      width="16"
                      height="16"
                    >
                      <path
                        d="M3.5 6.5 8 11l4.5-4.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </summary>
                  {row.experience.publicContext.map((paragraph) => (
                    <p set:html={renderRich(paragraph)} />
                  ))}
                </details>
              )}
            </article>
          </li>
        )
      )}
    </ol>
  </div>
</section>

<style>
  .experience-section {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .experience-layout {
    display: grid;
    gap: 3rem;
  }

  .experience-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience-list > li {
    display: grid;
    gap: 1.5rem;
    border-top: 1px solid var(--line-strong);
    padding-block: 2.25rem;
  }

  .role-meta {
    align-self: start;
  }

  .period {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--font-meta);
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }

  .domain {
    margin-top: 0.4rem;
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: var(--font-meta);
    line-height: 1.5;
  }

  .additional-break {
    padding-bottom: 0.25rem;
  }

  .additional-heading {
    color: var(--text);
    font-size: var(--font-lead);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .additional-note {
    max-width: 68ch;
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: var(--font-small);
    line-height: 1.55;
  }

  article h3,
  article h4 {
    display: grid;
    gap: 0.35rem;
  }

  .employer {
    color: var(--muted-strong);
    font-size: var(--font-small);
    font-weight: 650;
    letter-spacing: 0;
  }

  .bullet-emphasis {
    color: var(--text);
    font-weight: 650;
  }

  article h3,
  article h4 {
    color: var(--text);
    font-size: var(--font-title);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .role-context {
    max-width: 68ch;
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: var(--font-small);
    font-style: italic;
    line-height: 1.55;
  }

  .source-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    margin-top: 0.65rem;
    color: var(--muted);
    font-size: var(--font-small);
  }

  .source-line a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--accent);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .public-context :global(a) {
    display: inline;
    color: var(--accent);
    text-decoration-line: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .public-context :global(a):hover {
    color: var(--accent-strong);
  }

  .public-context {
    max-width: 68ch;
    margin-top: 1.25rem;
  }

  .public-context summary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
    font-size: var(--font-small);
    font-weight: 650;
    cursor: pointer;
  }

  .public-context .chevron {
    color: var(--accent-strong);
    transition: transform 180ms var(--ease-out);
  }

  .public-context[open] .chevron {
    transform: rotate(180deg);
  }

  .public-context p {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: var(--font-body);
    line-height: 1.7;
  }

  article ul {
    display: grid;
    gap: 0.9rem;
    margin: 1.35rem 0 0;
    padding-left: 1.2rem;
    list-style: disc;
    color: var(--muted);
    font-size: var(--font-body);
    line-height: 1.75;
  }

  article li::marker {
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .experience-layout {
      grid-template-columns: minmax(14rem, 0.58fr) minmax(0, 1.42fr);
      gap: clamp(4rem, 9vw, 9rem);
    }

    .experience-intro {
      position: sticky;
      top: 4.75rem;
      align-self: start;
    }

    .experience-list > li {
      grid-template-columns: minmax(9rem, 0.35fr) minmax(0, 1fr);
      gap: 2rem;
    }

    .additional-copy {
      grid-column: 2;
    }
  }
</style>
