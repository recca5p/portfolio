---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="site-container footer-row">
    <p>
      &copy; {currentYear} Tan Phat Vo. {t('footer.rights')}
    </p>
    <nav aria-label={lang === 'en' ? 'Footer links' : 'Liên kết cuối trang'}>
      <a href="mailto:phatvo73.dev@gmail.com">Email</a>
      <a
        href="https://www.linkedin.com/in/tan-phat-vo-51ba10272/"
        target="_blank"
        rel="noopener noreferrer"
        translate="no"
      >
        LinkedIn
      </a>
    </nav>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--line);
    background: var(--page);
  }

  .footer-row {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: 2rem;
    color: var(--muted);
    font-size: 0.72rem;
  }

  nav {
    display: flex;
    gap: 1.25rem;
  }

  a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    color: var(--muted-strong);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  a:hover {
    color: var(--text);
    text-decoration-color: var(--accent);
  }

  @media (min-width: 640px) {
    .footer-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
