---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const phone = '+84779342459';
const phoneDisplay = '+84 779 342 459';
const email = 'phatvo73.dev@gmail.com';
const linkedinUrl = 'https://www.linkedin.com/in/tan-phat-vo-51ba10272/';
const whatsappUrl = `https://wa.me/${phone.replace('+', '')}`;
const zaloUrl = `https://zalo.me/${phone.replace('+', '')}`;
const whatsappQr = `https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(whatsappUrl)}&bgcolor=11181e&color=24bcae`;
const zaloQr = `https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${encodeURIComponent(zaloUrl)}&bgcolor=11181e&color=24bcae`;
---

<section id="contact" class="section-shell contact-section" aria-labelledby="contact-heading">
  <div class="site-container contact-layout">
    <div class="contact-intro">
      <h2 id="contact-heading" class="section-heading">
        {t('contact.title')}
      </h2>
      <p class="section-copy">{t('contact.subtitle')}</p>
      <a class="button-primary" href={`mailto:${email}`}>
        {t('home.emailCta')}
      </a>
    </div>

    <div class="contact-channels">
      <a class="contact-row pressable" href={`mailto:${email}`}>
        <span>Email</span>
        <strong>{email}</strong>
      </a>

      <a class="contact-row pressable" href={linkedinUrl} target="_blank" rel="noopener noreferrer">
        <span translate="no">LinkedIn</span>
        <strong translate="no">tan-phat-vo</strong>
      </a>

      <div class="contact-row contact-with-qr">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          <span translate="no">WhatsApp</span>
          <strong>{phoneDisplay}</strong>
        </a>
        <details>
          <summary>{t('contact.showQr')}</summary>
          <div class="qr-panel">
            <p>{t('contact.scanToChat')}</p>
            <img
              src={whatsappQr}
              alt={lang === 'en' ? 'WhatsApp contact QR code' : 'Mã QR liên hệ WhatsApp'}
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
            />
          </div>
        </details>
      </div>

      <div class="contact-row contact-with-qr">
        <a href={zaloUrl} target="_blank" rel="noopener noreferrer">
          <span translate="no">Zalo</span>
          <strong>{phoneDisplay}</strong>
        </a>
        <details>
          <summary>{t('contact.showQr')}</summary>
          <div class="qr-panel">
            <p>{t('contact.scanToChat')}</p>
            <img
              src={zaloQr}
              alt={lang === 'en' ? 'Zalo contact QR code' : 'Mã QR liên hệ Zalo'}
              width="160"
              height="160"
              loading="lazy"
              decoding="async"
            />
          </div>
        </details>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .contact-layout {
    display: grid;
    gap: 3rem;
  }

  .contact-intro .section-copy {
    margin-top: 1.35rem;
  }

  .contact-intro .button-primary {
    margin-top: 2rem;
  }

  .contact-channels {
    border-top: 1px solid var(--line-strong);
  }

  .contact-row {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(6rem, 0.4fr) minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-block: 1.2rem;
    transition:
      color 160ms ease,
      transform 160ms var(--ease-out);
  }

  a.contact-row:hover,
  .contact-with-qr > a:hover {
    color: var(--accent-strong);
  }

  .contact-row span {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .contact-row strong {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--text);
    font-size: 0.88rem;
  }

  .contact-with-qr {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
  }

  .contact-with-qr > a {
    display: grid;
    min-width: 0;
    min-height: 2.75rem;
    align-content: center;
    grid-template-columns: minmax(6rem, 0.4fr) minmax(0, 1fr);
    gap: 1rem;
    transition: color 160ms ease;
  }

  .contact-with-qr summary {
    width: fit-content;
    margin-left: auto;
    min-height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.72rem 0.8rem;
    color: var(--muted-strong);
    cursor: pointer;
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  .contact-with-qr summary:hover,
  .contact-with-qr details[open] summary {
    border-color: var(--line-strong);
    background: var(--surface-raised);
    color: var(--text);
  }

  .contact-with-qr details[open] {
    grid-column: 1 / -1;
  }

  .qr-panel {
    width: min(100%, 12rem);
    margin-top: 0.75rem;
    margin-left: auto;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--page);
    padding: 0.9rem;
  }

  .qr-panel p {
    margin-bottom: 0.65rem;
    color: var(--muted);
    font-size: 0.68rem;
    text-align: center;
  }

  .qr-panel img {
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 0.3rem);
  }

  @media (min-width: 900px) {
    .contact-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(28rem, 1.2fr);
      gap: clamp(4rem, 9vw, 9rem);
    }
  }

  @media (max-width: 520px) {
    .contact-row,
    .contact-with-qr > a {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
