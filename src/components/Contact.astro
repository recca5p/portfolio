---
import QRCode from 'qrcode';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const whatsappUrl = `https://wa.me/${profile.phoneE164.replace('+', '')}`;
const zaloUrl = `https://zalo.me/${profile.phoneE164.replace('+', '')}`;

const toQr = async (value: string, label: string) => {
  const svg = await QRCode.toString(value, {
    type: 'svg',
    margin: 1,
    width: 160,
    color: { dark: '#24bcae', light: '#11181e' },
  });
  return svg
    .replace(/<\?xml[^>]*>\s*/i, '')
    .replace('<svg ', `<svg role="img" aria-label="${label}" `);
};

const whatsappQr = await toQr(
  whatsappUrl,
  lang === 'en' ? 'WhatsApp contact QR code' : 'Mã QR liên hệ WhatsApp'
);
const zaloQr = await toQr(zaloUrl, lang === 'en' ? 'Zalo contact QR code' : 'Mã QR liên hệ Zalo');
---

<section id="contact" class="section-shell contact-section" aria-labelledby="contact-heading">
  <div class="site-container contact-layout">
    <div class="contact-intro">
      <h2 id="contact-heading" class="section-heading">
        {t('contact.title')}
      </h2>
      <p class="section-copy">{t('contact.subtitle')}</p>
      <div class="contact-actions">
        <a class="button-primary" href={`mailto:${profile.email}`}>
          {t('home.emailCta')}
        </a>
        <a class="button-secondary" href={profile.cvPath} download>
          {t('home.downloadCv')}
        </a>
      </div>
    </div>

    <div class="contact-channels">
      <div class="contact-row">
        <span>Email</span>
        <a href={`mailto:${profile.email}`}>
          <strong>{profile.email}</strong>
        </a>
        <button
          type="button"
          class="copy-email"
          data-email={profile.email}
          data-label={t('contact.copyEmail')}
          data-copied={t('contact.copied')}
        >
          {t('contact.copyEmail')}
        </button>
      </div>

      <div class="contact-row">
        <span translate="no">LinkedIn</span>
        <a href={profile.linkedinUrl} target="_blank" rel="noopener noreferrer">
          <strong translate="no">{profile.linkedinLabel}</strong>
        </a>
      </div>

      <div class="contact-row">
        <span translate="no">WhatsApp</span>
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          <strong>{profile.phoneDisplay}</strong>
        </a>
        <details>
          <summary>{t('contact.showQr')}</summary>
          <div class="qr-panel">
            <p>{t('contact.scanToChat')}</p>
            <Fragment set:html={whatsappQr} />
          </div>
        </details>
      </div>

      <div class="contact-row">
        <span translate="no">Zalo</span>
        <a href={zaloUrl} target="_blank" rel="noopener noreferrer">
          <strong>{profile.phoneDisplay}</strong>
        </a>
        <details>
          <summary>{t('contact.showQr')}</summary>
          <div class="qr-panel">
            <p>{t('contact.scanToChat')}</p>
            <Fragment set:html={zaloQr} />
          </div>
        </details>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.copy-email').forEach(function (button) {
    button.addEventListener('click', function () {
      var email = button.getAttribute('data-email') || '';
      var copied = button.getAttribute('data-copied') || 'Copied';
      var label = button.getAttribute('data-label') || 'Copy email';
      var done = function () {
        button.textContent = copied;
        window.setTimeout(function () {
          button.textContent = label;
        }, 1600);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(email).then(done);
      }
    });
  });
</script>

<style>
  .contact-section {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }

  .contact-layout {
    display: grid;
    gap: 3rem;
  }

  .contact-intro .section-copy {
    margin-top: 1.35rem;
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .contact-channels {
    border-top: 1px solid var(--line-strong);
  }

  .contact-row {
    display: grid;
    grid-template-columns: 8.75rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1rem;
    border-bottom: 1px solid var(--line);
    padding-block: 0.35rem;
  }

  .contact-row > span,
  .contact-row > a,
  .copy-email,
  .contact-row summary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }

  .contact-row > span {
    color: var(--muted);
    font-size: var(--font-small);
  }

  .contact-row a {
    min-width: 0;
    color: var(--text);
    transition: color 160ms ease;
  }

  .contact-row a:hover {
    color: var(--accent-strong);
  }

  .contact-row strong {
    overflow-wrap: anywhere;
    font-size: var(--font-small);
    font-weight: 650;
  }

  .copy-email,
  .contact-row summary {
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.4rem 0.8rem;
    background: transparent;
    color: var(--muted-strong);
    cursor: pointer;
    font-size: var(--font-small);
    font-weight: 700;
    white-space: nowrap;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }

  .copy-email:hover,
  .contact-row summary:hover,
  .contact-row details[open] summary {
    border-color: var(--line-strong);
    background: var(--surface-raised);
    color: var(--text);
  }

  .contact-row details {
    position: relative;
    justify-self: end;
  }

  .qr-panel {
    position: absolute;
    right: 0;
    z-index: 2;
    width: min(100vw - 2rem, 12rem);
    margin-top: 0.35rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--page);
    padding: 0.9rem;
  }

  .qr-panel p {
    margin-bottom: 0.65rem;
    color: var(--muted);
    font-size: var(--font-small);
    text-align: center;
  }

  .qr-panel :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 0.3rem);
  }

  @media (min-width: 900px) {
    .contact-layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(28rem, 1.2fr);
      gap: clamp(4rem, 9vw, 9rem);
    }
  }

  @media (max-width: 520px) {
    .contact-row {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .contact-row > span {
      grid-column: 1 / -1;
    }
  }
</style>
