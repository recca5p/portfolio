---
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/utils';
import manropeLatinUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import manropeVietnameseUrl from '@fontsource-variable/manrope/files/manrope-vietnamese-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** Override the canonical URL path (defaults to current pathname) */
  canonicalPath?: string;
  pageType: 'profile' | 'collection';
}

const {
  title,
  description = 'Senior Backend Engineer specializing in .NET, Golang, Java, Microservices, Cloud-Native Architecture (GCP, AWS, Azure), and AI-augmented development. 5+ years of experience.',
  lang = 'en',
  canonicalPath,
  pageType,
} = Astro.props;

const site = Astro.site ?? new URL('https://portfolio-7j9.pages.dev');
const siteUrl = site.origin;
const normalizePath = (path: string): string => {
  const pathname = path.startsWith('/') ? path : `/${path}`;
  return pathname === '/' ? pathname : `${pathname.replace(/\/+$/, '')}/`;
};

const currentPath = normalizePath(canonicalPath ?? Astro.url.pathname);
const canonicalUrl = new URL(currentPath, site).href;
const altLang = lang === 'en' ? 'vi' : 'en';
const altPath = currentPath.replace(`/${lang}`, `/${altLang}`);
const altUrl = new URL(altPath, site).href;
const xDefaultUrl = new URL('/en/', site).href;
const ogLocale = lang === 'en' ? 'en_US' : 'vi_VN';
const ogLocaleAlt = lang === 'en' ? 'vi_VN' : 'en_US';
const ogType = pageType === 'profile' ? 'profile' : 'website';
const socialImageUrl = new URL('/logo.png', site).href;
const socialImageAlt =
  lang === 'en' ? 'Tan Phat Vo portfolio logo' : 'Logo portfolio của Võ Tấn Phát';

const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const webpageId = `${canonicalUrl}#webpage`;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;

// Shared entity referenced by each localized page.
const personSchema = {
  '@type': 'Person',
  '@id': personId,
  name: 'Tan Phat Vo',
  alternateName: 'Võ Tấn Phát',
  description:
    lang === 'en'
      ? 'Senior Backend Engineer specializing in .NET, Golang, cloud-native microservices, and AI-augmented engineering.'
      : 'Kỹ sư Backend Senior chuyên về .NET, Golang, microservices cloud-native và kỹ thuật tăng cường AI.',
  jobTitle: 'Senior Backend Engineer',
  url: new URL('/en/', site).href,
  sameAs: ['https://www.linkedin.com/in/tan-phat-vo-51ba10272/'],
  knowsAbout: [
    '.NET Core',
    'Golang',
    'Java',
    'Python',
    'Microservices',
    'Cloud Architecture',
    'GCP',
    'AWS',
    'Azure',
    'Kubernetes',
    'Docker',
    'Kafka',
    'gRPC',
    'Redis',
    'AI Engineering',
  ],
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'Ton Duc Thang University',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Ho Chi Minh City',
      addressCountry: 'VN',
    },
  },
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Microsoft Power Platform Developer Associate',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'IELTS 6.5',
      credentialCategory: 'English Proficiency',
    },
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'ANZ Bank (Australia) - Digital Banking Division',
  },
};

// Site identity. Do not add SearchAction unless a real query-driven search exists.
const websiteSchema = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: 'Tan Phat Vo - Senior Backend Engineer',
  alternateName: 'Võ Tấn Phát - Kỹ sư Backend Senior',
  url: xDefaultUrl,
  description:
    'Bilingual portfolio of Senior Backend Engineer Tan Phat Vo, covering backend, cloud, fintech, AI, and automation work.',
  inLanguage: ['en', 'vi'],
  publisher: { '@id': personId },
};

const breadcrumbSchema =
  pageType === 'collection'
    ? {
        '@type': 'BreadcrumbList',
        '@id': breadcrumbId,
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: lang === 'en' ? 'Home' : 'Trang chủ',
            item: new URL(`/${lang}/`, site).href,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: lang === 'en' ? 'Projects' : 'Dự án',
            item: canonicalUrl,
          },
        ],
      }
    : undefined;

const webpageSchema = {
  '@type': pageType === 'profile' ? 'ProfilePage' : 'CollectionPage',
  '@id': webpageId,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { '@id': websiteId },
  ...(pageType === 'profile'
    ? { mainEntity: { '@id': personId } }
    : {
        about: { '@id': personId },
        breadcrumb: { '@id': breadcrumbId },
      }),
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [websiteSchema, personSchema, webpageSchema, breadcrumbSchema].filter(Boolean),
};

const profileMeta =
  pageType === 'profile'
    ? {
        firstName: 'Tan Phat',
        lastName: 'Vo',
        username: 'Tan Phat Vo',
      }
    : undefined;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="192x192" href="/logo-192.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="192x192" href="/logo-192.png" />
    <link
      rel="preload"
      href={manropeLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {lang === 'vi' && (
      <link
        rel="preload"
        href={manropeVietnameseUrl}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    )}

    <!-- === Primary SEO === -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tan Phat Vo" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="theme-color" content="#0b1014" />

    <!-- === Canonical & Language Alternates === -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={altLang} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link rel="me" href="https://www.linkedin.com/in/tan-phat-vo-51ba10272/" />

    <!-- === Open Graph (Facebook / LinkedIn) === -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Tan Phat Vo - Portfolio" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="640" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={socialImageAlt} />
    {profileMeta && (
      <>
        <meta property="profile:first_name" content={profileMeta.firstName} />
        <meta property="profile:last_name" content={profileMeta.lastName} />
        <meta property="profile:username" content={profileMeta.username} />
      </>
    )}

    <!-- === Twitter / X Card === -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- === Preconnect hints === -->
    {pageType === 'profile' && (
      <>
        <link rel="preconnect" href="https://api.qrserver.com" />
        <link rel="dns-prefetch" href="https://api.qrserver.com" />
      </>
    )}

    <!-- === JSON-LD Structured Data === -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>

  <body class="flex min-h-[100dvh] flex-col">
    <!-- Skip-to-content for keyboard / screen-reader users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-[var(--radius)] focus:bg-primary-400 focus:px-4 focus:py-3 focus:font-semibold focus:text-[#071310]"
    >
      {lang === 'en' ? 'Skip to main content' : 'Chuyển đến nội dung chính'}
    </a>

    <Header />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
