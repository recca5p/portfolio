---
import '../styles/global.css';

import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/logo-192.png';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/utils';
import manropeLatinUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import manropeVietnameseUrl from '@fontsource-variable/manrope/files/manrope-vietnamese-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** Override the canonical URL path (defaults to current pathname) */
  canonicalPath?: string;
  pageType?: 'profile' | 'collection';
  indexable?: boolean;
}

const {
  title,
  description = 'I build Go and gRPC backends for ANZ Plus in Ho Chi Minh City. I plan, write and test that work with Cursor and Claude Code.',
  lang = 'en',
  canonicalPath,
  pageType = 'profile',
  indexable = true,
} = Astro.props;

const site = Astro.site ?? new URL(profile.site);
const siteUrl = site.origin;
const normalizePath = (path: string): string => {
  const pathname = path.startsWith('/') ? path : `/${path}`;
  return pathname === '/' ? pathname : `${pathname.replace(/\/+$/, '')}/`;
};

const currentPath = normalizePath(canonicalPath ?? Astro.url.pathname);
const canonicalUrl = new URL(currentPath, site).href;
const altLang = lang === 'en' ? 'vi' : 'en';
const englishPath = currentPath.startsWith('/vi/')
  ? currentPath.replace(/^\/vi\//, '/en/')
  : currentPath.startsWith('/en/')
    ? currentPath
    : '/en/';
const altPath = currentPath.startsWith(`/${lang}/`)
  ? currentPath.replace(`/${lang}/`, `/${altLang}/`)
  : `/${altLang}/`;
const altUrl = new URL(altPath, site).href;
const xDefaultUrl = new URL(englishPath, site).href;
const ogLocale = lang === 'en' ? 'en_US' : 'vi_VN';
const ogLocaleAlt = lang === 'en' ? 'vi_VN' : 'en_US';
const ogType = pageType === 'profile' ? 'profile' : 'website';
const ogImagePath = lang === 'vi' ? '/og/og-vi.png' : '/og/og-en.png';
const socialImageUrl = new URL(ogImagePath, site).href;
const socialImageAlt =
  lang === 'en'
    ? 'Tan Phat Vo, Senior Software Engineer — Applied AI & Backend, Ho Chi Minh City'
    : 'Võ Tấn Phát, Kỹ sư phần mềm senior — AI ứng dụng & Backend, Thành phố Hồ Chí Minh';
const icon = await getImage({ src: logo, width: 192, height: 192, format: 'png' });
const personImageUrl = new URL('/og/og-en.png', site).href;

const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;
const webpageId = `${canonicalUrl}#webpage`;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;

const personSchema = {
  '@type': 'Person',
  '@id': personId,
  name: profile.name.en,
  alternateName: profile.name.vi,
  description:
    lang === 'en'
      ? 'Senior software engineer focused on applied AI and backend systems. Current role is Software Engineer at ANZ Bank (via HCLTech Vietnam), building Go and gRPC services for ANZ Plus. I plan, write and test that work with Cursor and Claude Code.'
      : 'Kỹ sư phần mềm senior, hướng tới AI ứng dụng và backend. Vai trò hiện tại là kỹ sư phần mềm tại ANZ Bank (qua HCLTech Việt Nam), xây dựng dịch vụ Go và gRPC cho ANZ Plus. Tôi lên kế hoạch, viết và kiểm thử công việc đó bằng Cursor và Claude Code.',
  jobTitle: profile.jobTitle.en,
  email: profile.email,
  image: personImageUrl,
  url: new URL('/en/', site).href,
  homeLocation: {
    '@type': 'Place',
    name: 'Ho Chi Minh City',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Ho Chi Minh City',
      addressCountry: 'VN',
    },
  },
  sameAs: [profile.linkedinUrl, profile.githubUrl],
  knowsAbout: [
    'Go',
    'gRPC',
    '.NET',
    'Java',
    'Python',
    'Applied AI',
    'Claude Code',
    'OpenTelemetry',
    'GCP',
    'AWS',
    'Azure',
    'Kubernetes',
    'Kafka',
  ],
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: lang === 'en' ? 'Ton Duc Thang University' : 'Trường Đại học Tôn Đức Thắng',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Ho Chi Minh City',
      addressCountry: 'VN',
    },
  },
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'Microsoft Power Platform Developer Associate',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'IELTS 6.5 (IDP)',
      credentialCategory: 'English proficiency',
    },
    {
      '@type': 'EducationalOccupationalCredential',
      name: 'TOEIC 700+',
      credentialCategory: 'English proficiency',
    },
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'ANZ Bank (via HCLTech Vietnam)',
  },
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: 'Tan Phat Vo — Senior Software Engineer — Applied AI & Backend',
  alternateName: 'Võ Tấn Phát — Kỹ sư phần mềm senior — AI ứng dụng & Backend',
  url: new URL('/en/', site).href,
  description:
    'Bilingual portfolio of Tan Phat Vo, senior software engineer, covering Go and gRPC services for ANZ Plus.',
  inLanguage: ['en', 'vi'],
  publisher: { '@id': personId },
};

const breadcrumbSchema =
  pageType === 'collection'
    ? {
        '@type': 'BreadcrumbList',
        '@id': breadcrumbId,
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: lang === 'en' ? 'Home' : 'Trang chủ',
            item: new URL(`/${lang}/`, site).href,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: lang === 'en' ? 'Projects' : 'Dự án',
            item: canonicalUrl,
          },
        ],
      }
    : undefined;

const webpageSchema = {
  '@type': pageType === 'profile' ? 'ProfilePage' : 'CollectionPage',
  '@id': webpageId,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { '@id': websiteId },
  ...(pageType === 'profile'
    ? { mainEntity: { '@id': personId } }
    : {
        about: { '@id': personId },
        breadcrumb: { '@id': breadcrumbId },
      }),
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [websiteSchema, personSchema, webpageSchema, breadcrumbSchema].filter(Boolean),
};

const profileMeta =
  pageType === 'profile' && indexable
    ? {
        firstName: 'Tan Phat',
        lastName: 'Vo',
        username: 'Tan Phat Vo',
      }
    : undefined;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="192x192" href={icon.src} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="192x192" href={icon.src} />
    <link
      rel="preload"
      href={manropeLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {lang === 'vi' && (
      <link
        rel="preload"
        href={manropeVietnameseUrl}
        as="font"
        type="font/woff2"
        crossorigin="anonymous"
      />
    )}

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tan Phat Vo" />
    <meta
      name="robots"
      content={
        indexable
          ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
          : 'noindex, nofollow'
      }
    />
    <meta name="theme-color" content="#0b1014" />

    {indexable && (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        <link rel="alternate" hreflang={altLang} href={altUrl} />
        <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
        <link rel="me" href={profile.linkedinUrl} />
      </>
    )}

    <meta property="og:type" content={ogType} />
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Tan Phat Vo — Portfolio" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    {profileMeta && (
      <>
        <meta property="profile:first_name" content={profileMeta.firstName} />
        <meta property="profile:last_name" content={profileMeta.lastName} />
        <meta property="profile:username" content={profileMeta.username} />
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    {indexable && (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>

  <body class="flex min-h-[100dvh] flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-[var(--radius)] focus:bg-primary-400 focus:px-4 focus:py-3 focus:font-semibold focus:text-[#071310]"
    >
      {lang === 'en' ? 'Skip to main content' : 'Chuyển đến nội dung chính'}
    </a>

    <Header />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
